<?xml version="1.0"?>
<package format="3">
  <name>rm_safe_demo</name>
  <version>0.1.0</version>
  <description>Safety-oriented bringup and small-motion tools for RM65/RM75.</description>
  <maintainer email="maintainer@example.com">maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rm_ros_interfaces</exec_depend>
  <exec_depend>rm_driver</exec_depend>
  <exec_depend>rm_description</exec_depend>
  <exec_depend>rm_control</exec_depend>
  <exec_depend>rm_65_config</exec_depend>
  <exec_depend>rm_75_config</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
